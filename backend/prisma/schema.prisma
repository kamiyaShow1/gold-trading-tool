generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // プロフィール
  hfmAccountId  String?
  // tradingLevel: 'beginner' | 'intermediate' | 'advanced'
  tradingLevel  String  @default("beginner")
  targetWinRate Int     @default(70)

  // 統計
  totalTrades     Int     @default(0)
  totalWins       Int     @default(0)
  totalLosses     Int     @default(0)
  currentWinRate  Float   @default(0)
  totalProfitLoss Float   @default(0)

  quizResults      QuizResult[]
  learningProgress LearningProgress?
  demoTrades       DemoTrade[]

  @@map("Users")
}

// 学習コンテンツは全ユーザー共通のカタログ。ユーザーごとの進捗は LearningProgress で管理する
model LearningContent {
  id        Int    @id @default(autoincrement())
  chapterId String @unique
  title     String

  // category: 'fx_basics' | 'gold_characteristics' | 'technical_analysis'
  //         | 'time_zones' | 'fundamental_analysis' | 'risk_management'
  category String

  content   String
  keyPoints Json?
  examples  Json?

  // difficulty: 'easy' | 'medium' | 'hard'
  difficulty    String @default("medium")
  estimatedTime Int?
  order         Int?

  quizzes Quiz[]

  @@map("LearningContent")
}

model Quiz {
  id        Int @id @default(autoincrement())
  contentId Int

  title         String
  description   String?
  questionsJson Json
  passingScore  Int     @default(80)

  createdAt DateTime @default(now())

  content LearningContent @relation(fields: [contentId], references: [id])
  results QuizResult[]

  @@map("Quizzes")
}

model QuizResult {
  id     Int @id @default(autoincrement())
  userId Int
  quizId Int

  score   Int
  passed  Boolean
  answers Json?
  feedback String?

  attemptDate DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  quiz Quiz @relation(fields: [quizId], references: [id])

  @@map("QuizResults")
}

// ユーザー1人につき1レコード。完了章の一覧・現在章・進捗率をまとめて保持する
model LearningProgress {
  id     Int @id @default(autoincrement())
  userId Int @unique

  completedChapters Json
  currentChapter    String?
  progressPercent   Int      @default(0)
  totalStudyTime    Int      @default(0)
  lastStudyDate     DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("LearningProgress")
}

model DemoTrade {
  id     Int @id @default(autoincrement())
  userId Int

  symbol String @default("XAUUSD")

  entryTime  DateTime @default(now())
  entryPrice Float
  // entryType: 'buy' | 'sell'
  entryType  String

  exitTime  DateTime?
  exitPrice Float?

  // ロット数。デモ用のデフォルトはマイクロロット
  lotSize Float @default(0.01)

  pips       Float?
  profitLoss Float?
  // status: 'open' | 'closed' | 'cancelled'
  status String @default("open")

  entryReason     String?
  exitReason      String?
  learningChapter String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("DemoTrades")
}

// 全ユーザー共通の相場データ(LearningContentと同じ理由でuserIdは持たない)
model MarketData {
  id Int @id @default(autoincrement())

  symbol String @default("XAUUSD")
  // timeframe: '1m' | '5m' | '15m' | '30m' | '1h' | '4h' | '1d'
  timeframe String
  timestamp DateTime

  open  Float
  high  Float
  low   Float
  close Float

  ema20  Float?
  ema75  Float?
  ema200 Float?
  rsi    Float?
  atr    Float?

  fomc        Boolean @default(false)
  nfp         Boolean @default(false)
  cpi         Float?
  dollarIndex Float?
  vix         Float?

  @@unique([symbol, timeframe, timestamp])
  @@map("MarketData")
}
